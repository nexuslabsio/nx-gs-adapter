# Normalize line endings to LF across all platforms.
* text=auto eol=lf

# Source and config files — always LF.
*.java   text eol=lf
*.kt     text eol=lf
*.kts    text eol=lf
*.gradle text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.toml   text eol=lf
*.properties text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.sh     text eol=lf

# Windows scripts keep CRLF.
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binary assets — never normalize.
*.jar    binary
*.png    binary
*.jpg    binary
*.gif    binary
*.ico    binary
